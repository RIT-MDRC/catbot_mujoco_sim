# Copy to ~/.config/catbot/training.env on the cluster and edit the entity.
# This is sourced as shell code; keep it private and do not put API keys here.
# Existing environment values take precedence, allowing per-job overrides.
export WANDB_ENTITY="${WANDB_ENTITY:-YOUR_WANDB_USER_OR_TEAM}"
export WANDB_PROJECT="${WANDB_PROJECT:-catbot}"
export WANDB_MODE="${WANDB_MODE:-online}"
export TRAIN_LOGGER="${TRAIN_LOGGER:-wandb}"
