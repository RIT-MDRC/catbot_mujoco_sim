			<geom name="rl_foot" type="sphere" pos="0 0 -0.17" size="0.02" rgba="0.1 0.1 0.1 1"/>
		</body>
	</body>

	<!-- Rear-right leg -->
	<body name="rr_hip" pos="-0.16 -0.09 -0.05" euler="0 45 0">
		<joint name="rr_hip_ball" type="ball" damping="0.5"/>
