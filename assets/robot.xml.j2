		</body>
	</body>

	<!-- Rear-left leg -->
	<body name="rl_hip" pos="-0.16 0.09 -0.05" euler="0 45 0">
		<joint name="rl_hip_ball" type="ball" damping="0.5"/>
		<geom name="rl_upper" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.018" rgba="0.2 0.2 0.2 1"/>
		<body name="rl_shin" pos="0 0 -0.16" euler="0 -90 0">
			<joint name="rl_knee" type="hinge" axis="0 1 0" range="-120 0" ref="-90" limited="true" damping="0.8"/>
