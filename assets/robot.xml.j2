<body name="quadruped" pos="0 0 0.35">
	<freejoint name="base_free"/>

	<!-- Rectangular prism torso -->
	<geom name="torso" type="box" size="0.20 0.10 0.05" rgba="0.6 0.6 0.6 1"/>

	<!-- Front-left leg -->
	<body name="fl_hip" pos="0.16 0.09 -0.05" euler="0 45 0">
