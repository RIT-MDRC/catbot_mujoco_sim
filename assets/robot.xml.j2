		<geom name="fl_upper" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.018" rgba="0.2 0.2 0.2 1"/>
		<body name="fl_shin" pos="0 0 -0.16" euler="0 -90 0">
			<joint name="fl_knee" type="hinge" axis="0 1 0" range="-120 0" ref="-90" limited="true" damping="0.8"/>
			<geom name="fl_lower" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.016" rgba="0.3 0.3 0.3 1"/>
			<geom name="fl_foot" type="sphere" pos="0 0 -0.17" size="0.02" rgba="0.1 0.1 0.1 1"/>
		</body>
	</body>

	<!-- Front-right leg -->
	<body name="fr_hip" pos="0.16 -0.09 -0.05" euler="0 45 0">
